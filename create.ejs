<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>Добавить машину</title>
</head>
<body>
    <h1>Новая машина</h1>
    <form method="post" action="/create">
        Марка: <input type="text" name="brand" required><br><br>
        Модель: <input type="text" name="model" required><br><br>
        Год: <input type="number" name="year" required><br><br>
        Цена: <input type="number" name="price" required><br><br>
        Цвет: <input type="text" name="color" required><br><br>
        
        <label>
            <input type="checkbox" name="available" checked> В наличии
        </label>
        <br><br>
        
        <button type="submit">Сохранить</button>
        <a href="/">Отмена</a>
    </form>
</body>
</html>