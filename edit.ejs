<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>Редактировать машину</title>
</head>
<body>
    <h1>Редактирование машины #<%= car.id %></h1>
    <form method="post" action="/edit/<%= car.id %>">
        Марка: <input type="text" name="brand" value="<%= car.brand %>" required><br><br>
        Модель: <input type="text" name="model" value="<%= car.model %>" required><br><br>
        Год: <input type="number" name="year" value="<%= car.year %>" required><br><br>
        Цена: <input type="number" name="price" value="<%= car.price %>" required><br><br>
        Цвет: <input type="text" name="color" value="<%= car.color %>" required><br><br>
        
        <label>
            <input type="checkbox" name="available" 
                <% if (car.available == true) { %> checked <% } %> > 
            В наличии
        </label>
        <br><br>
        
        <button type="submit">Сохранить</button>
        <a href="/">Отмена</a>
    </form>
</body>
</html>