<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>Автосалон</title>
</head>
<body>
    <h1>Список машин</h1>
    <a href="/create">Добавить машину</a>
    
    <table border="1" cellpadding="5" style="margin-top:10px;">
        <tr>
            <th>ID</th>
            <th>Марка</th>
            <th>Модель</th>
            <th>Год</th>
            <th>Цена</th>
            <th>Цвет</th>
            <th>В наличии</th>
            <th>Действия</th>
        </tr>
        
        <% for (var i = 0; i < cars.length; i++) { %>
            <tr>
                <td><%= cars[i].id %></td>
                <td><%= cars[i].brand %></td>
                <td><%= cars[i].model %></td>
                <td><%= cars[i].year %></td>
                <td><%= cars[i].price %></td>
                <td><%= cars[i].color %></td>
                <td>
                    <% if (cars[i].available == 1) { %>
                        Да
                    <% } else { %>
                        Нет
                    <% } %>
                </td>
                <td>
                    <a href="/edit/<%= cars[i].id %>">Изменить</a> | 
                    <a href="/delete/<%= cars[i].id %>">Удалить</a>
                </td>
            </tr>
        <% } %>
    </table>
</body>
</html>