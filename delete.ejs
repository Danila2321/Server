<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <title>Удалить машину</title>
</head>
<body>
    <h1>Удалить машину?</h1>
    <p>
        Вы уверены, что хотите удалить 
        <%= car.brand %> <%= car.model %>?
    </p>
    <form method="post" action="/delete/<%= car.id %>">
        <button type="submit">Да</button>
        <a href="/">Отмена</a>
    </form>
</body>
</html>